# Optional advanced setting. Leave unset for normal installs; the app creates
# and stores its own encryption secret in the persistent data folder.
# APP_SECRET=replace-with-a-long-random-secret

# Optional cross-origin UI origins, comma-separated. The production Docker UI is
# served from the same origin and does not need CORS.
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional Rspamd settings profile to send as the Settings-ID scan header.
# RSPAMD_SETTINGS_ID=full_scan
